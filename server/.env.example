# Copy this file to .env and fill it in. Never commit .env.
PORT=4000
# MongoDB Atlas connection string (free tier works)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/clinic?retryWrites=true&w=majority
# At least 32 random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Allowed front-end origin(s), comma separated
CLIENT_ORIGIN=http://localhost:5173
# Clinic time zone, used to decide which dates and slots are in the past
CLINIC_TZ=Africa/Cairo
# Used only by "npm run seed" to create the first admin (password: 12+ characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
